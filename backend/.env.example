# 복사해서 .env 로 쓰거나 export 로 등록
# PostgreSQL 전용. 아래 기본값은 docker-compose 의 db 와 일치 → 로컬 실행 시 그대로 붙음.
# (안 적으면 app/config.py 의 동일 기본값 사용)
DATABASE_URL=
# 테스트 DB(pytest). compose 가 자동 생성. 다른 PostgreSQL 쓰려면 여기서 교체.
TEST_DATABASE_URL=

# DART 인증키 (https://opendart.fss.or.kr) — 재무(PER=시총/순이익, PBR=시총/자본총계) 산출용
DART_API_KEY=

DART_BSNS_YEAR=2025
DART_REPRT_CODE=11011

# OUTOFSTOCK 유니버스 크기: KRX 시총 상위 N종목(예: 150). fetch-market/real 이 이 값을 따름.
UNIVERSE_TOP_N=3000
# NEWS_PER_STOCK=20          # 종목별 RSS 기사 수(뉴스 화면의 보도량 집계에 쓰임, 기본 20)

# KIS(한국투자증권) 실시간 — python run.py realtime(-kr) 로 켬. 모의투자 계좌면 KIS_PAPER=true
# 장 마감 후에도 '오늘 종가'를 KIS REST 로 받아 표시(수집기 시작 시·15:40 이후 자동)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER=false

# KRX 정보데이터시스템 OpenAPI (https://openapi.krx.co.kr) — 일별 시세/지수 실데이터(헤더 AUTH_KEY)
KRX_API_KEY=
# 시세 소스: krx(실데이터) | gen(생성/오프라인). 네이버 미사용.
MARKET_SOURCE=krx

LOG_LEVEL=INFO

# ── 보안(선택) — 기본값은 개발·데모용. 외부에 공개할 땐 env.prod.example 의 권장값(경계·세션·키·egress·로그)을 쓴다 ──
# DOCS_ENABLED=true          # false 면 /docs·/redoc·/openapi.json 숨김
# CORS_ORIGINS=              # 다른 출처의 화면이 API 를 부를 때만(쉼표). 쿠키는 보내지 않는다 — 같은 서버가 화면을 주면 비워 둔다
# LOGIN_MAX_FAILS=5          # 같은 IP·아이디로 10분 동안 5번 틀리면 잠시 429
# REGISTER_MAX_PER_IP=20     # IP 당 1시간 가입 시도
# PRACTICE_RECORD_MAX_PER_HOUR=120   # 계정당 1시간 웹 실습 기록 수(화면 '학습 및 실습하기')
# HEAVY_MISS_PER_MIN=12      # 백테스트·모형 비교를 새로 계산하는 요청: IP 당 1분 횟수(캐시로 답하는 요청은 무제한)
# MAX_BODY_BYTES=1000000     # 요청 본문 상한(넘으면 413)
# PASSWORD_HASH_ITERATIONS=600000   # PBKDF2 반복 횟수(OWASP 2023) — 기존 비밀번호는 로그인 때 자동 상향
# APP_SECRET_KEY=            # 마스터 키(비밀번호 페퍼·IP 가명화 하위 키 파생) — 비우면 개발용 고정 키(경고)
# EGRESS_MODE=enforce        # 나가는 연결 허용 목록 — monitor(기록만) · off
# 뉴스 수집(매일 23:00 run.py real 안에서 한 번): 요청 간격(초) · 연속 실패 몇 번이면 그 회차 중단
# NEWS_REQUEST_GAP=0.5
# NEWS_MAX_FAILS=5

# ── 추가 기능(가상머니 지갑) 튜닝값 — 선택(기본값 있음, 안 적어도 동작) ──
WALLET_WELCOME_BONUS=1000000
# 출석 보상(원) — 팀 시안 버튼의 '+500원'은 예시 문구, 화면은 이 값을 그대로 보여 준다(systemd 는 줄 끝 주석을 값으로 읽으므로 주석은 윗줄에)
ATTENDANCE_DAILY_REWARD=1000000
# Daily Stock Quiz 정답 1문제당 보상(원, 하루 1번 — 5문제 만점이면 5배). 0 이면 보상 없음
# QUIZ_REWARD_PER_CORRECT=100000
TRANSFER_MAX=100000000
# 인앱결제 영수증 검증: stub(데모) | strict(스토어 서버 검증 연동)
IAP_VERIFY_MODE=stub

# 토스페이먼츠(웹 결제) — 키 넣고 TOSS_MODE=real 이면 실제 결제. 비우면 데모(모의)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MODE=stub

# ── 해외 주식(미국) — 일봉·지수·환율은 키 없이 실데이터(python run.py real / fetch-overseas), 실시간만 Finnhub 키 ──
# 소스: auto(real 실행 시 FDR 실데이터, 실패 종목만 표본) | gen(항상 오프라인 표본)
OVERSEAS_SOURCE=auto
# Finnhub 무료 키 (https://finnhub.io) — 해외 실시간(python run.py realtime-us). ★비밀키: 소스/깃에 올리지 말 것
# (해외 일봉·지수·환율은 키 없이 FinanceDataReader 로 수집: python run.py fetch-overseas)
FINNHUB_API_KEY=
# SEC EDGAR 재무 — 인증키 아님. '식별용 연락처'를 요구하므로 본인 이메일로 교체 권장
SEC_USER_AGENT=
# 한국수출입은행 환율 키 (https://www.koreaexim.go.kr) — 선택. 비우면 폴백 환율 사용
EXIM_API_KEY=

# ── 배치 스케줄(python scheduler.py) — 매일 이 시각(한국시간)에 python run.py real 전체 실행 ──
REAL_PIPELINE_TIME=23:00
REAL_PIPELINE_DAYS=mon-sun
# 스케줄러가 꺼져 정기 실행을 놓쳤으면(마지막 성공 26시간 초과) 켜질 때 1회 보충 실행
REAL_PIPELINE_CATCHUP=true

# ── 지수(코스피·코스닥) — KIS 실시간 → 야후 → KRX(D-1) → FDR 순으로 받고 출처·기준일을 기록 ──
# KRX 지수 API 는 키와 별개로 'KOSPI/KOSDAQ 시리즈 일별시세정보' 이용신청이 필요(없으면 다른 소스로 대체)
# INDEX_LIVE_REFRESH=true      # 장중 홈 화면 요청 시 60초마다 백그라운드 갱신(false 면 배치·실시간 수집기만)
# KRX_API_BASE=https://data-dbg.krx.co.kr/svc/apis/

# ── 오늘의 추천 종목(멀티팩터 모델) ──
# RECO_MIN_VALUE=500000000     # 20일 평균 거래대금 하한(원) — 유니버스 중앙값의 5% 와 비교해 작은 값 사용
# RECO_COST_BPS=25             # 백테스트 왕복 거래비용 가정(0.25%)
# RISK_FREE_RATE=0.03         # Merton 부도거리(DD)·부도확률(PD) 계산용 무위험이자율(연)

# ── 장애 알림(선택) — 배치 실패·적재 검증 실패·수집기 중단을 바로 알린다(설정한 채널 모두로) ──
# 시험 전송: python run.py alert-test     최근 알림·검증 결과: python run.py quality  /  GET /health
# 웹훅(Slack·Discord·일반 JSON POST) ★비밀값: 웹훅 주소 자체가 비밀번호 역할
ALERT_WEBHOOK_URL=
# 텔레그램 봇(@BotFather 로 만든 토큰 + 받을 채팅 ID) ★비밀키
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 메일(STARTTLS). Gmail 은 '앱 비밀번호' 사용 ★비밀키
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# 같은 알림을 다시 보내지 않는 시간(알림 폭주 방지)
# ALERT_DEDUP_HOURS=6
# ALERT_ACK_MINUTES=15         # 오류 경보를 이 시간 안에 아무도 확인하지 않으면 한 번 상향(관제)

# IT 내부통제(ADR-0026) — 변경관리 게이트: record(기본, 기록만) · enforce(승인된 설치본만·배포 금지 시간) · off
# CHANGE_GATE=record
# CHANGE_FREEZE=mon-fri 08:30-16:00
# 가용성 감시(1분) — auto = http://127.0.0.1:$PORT/health · off 면 끔. 한 번도 정상 응답이 없으면 장애로 보지 않는다
# UPTIME_URL=auto
# UPTIME_SLO=99.5
# DR_RTO_TARGET_MIN=180        # 복구목표시간(분) — 감독규정 제23조
# 적재 검증(품질 게이트) 기준 — 유니버스의 90% 이상 적재, 종목의 90% 이상이 최근 60봉 이상
# QUALITY_MIN_UNIVERSE_RATIO=0.9
# QUALITY_MIN_HISTORY_BARS=60
# QUALITY_MIN_HISTORY_SHARE=0.9

# ── 정보보호(3번) ──
# 데이터 암호화 키(AES-256-GCM) — KIS 접근토큰·결제 키를 DB 에 암호화 저장. ★비밀키(소스·깃 금지)
#   생성: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
# 키 교체 때 예전 키(쉼표로 여러 개) — 읽기만
# DATA_ENCRYPTION_KEYS_OLD=
# 관리자(신고 처리·감사 로그 열람) 아이디 — 쉼표로
ADMIN_USERS=
# Content-Security-Policy — 비우면 기본 정책, 'off' 면 끔
# SECURITY_CSP=
# DB 권한 분리(deploy/sql/roles.sql) 후: 서비스는 oos_app, 분석 CLI 는 oos_ro, 마이그레이션은 oos_owner
# ANALYTICS_DATABASE_URL=postgresql+psycopg://oos_ro:비번@localhost:5432/outofstock
# MIGRATION_DATABASE_URL 은 서비스 .env 가 아니라 업데이트 때만 따로 넘기는 것을 권장
# AUDIT_RETENTION_DAYS=1095
# ACCESS_LOG_RETENTION_DAYS=365

# ── 시장 데이터(선택) — 한국은행 ECOS(금리·환율 공식 시계열). https://ecos.bok.or.kr 무료·즉시 발급 ★비밀키
ECOS_API_KEY=
# 분석 계층(전 종목 × N년) — 백필 기간·배치 1회 KRX 호출 예산
# ANALYTICS_YEARS=10
# ANALYTICS_BACKFILL_BUDGET=1200
# 테마 근거 수집 예산(배치 1회) — 사업보고서 원문(DART) 호출 수 · ETF 구성종목(KIS) 호출 수

# ── 용량·성능 관리 · 대량접속제어(ADR-0023 — 금감원 IT 안정성 가이드라인 '성능 관리') ──────────────────
# 임계치 4단계(정상·주의·경계·심각) = 워커별 동시 요청/한도 · DB 연결 사용률(비율) + p95 지연(ms) · 5xx 비율.
# 경계면 공개 시세·뉴스(low), 심각이면 일반 조회(normal)까지 503 — 로그인·송금·결제·관리(critical)는 끝까지 받는다
# CAPACITY_ADMISSION=on
# CAPACITY_MAX_INFLIGHT=40                 # 워커 하나의 스레드풀(40)에 맞춤 — 워커가 여럿이면 서버 한도 = 이 값 × 워커 수
# CAPACITY_RATIOS=0.6,0.8,0.95             # 주의·경계·심각
# CAPACITY_P95_MS=500,1000,3000
# CAPACITY_REPORT_COOLDOWN_S=600           # 같은 단계 성능관리보고서는 10분에 1번
# DB_POOL_TIMEOUT_S=5                      # 연결 풀이 다 찼을 때 기다리는 시간(초) — 넘으면 503(Retry-After)

# ── DB 운영(ADR-0027 — 저장 표준·수명주기·진단·서버 튜닝) ───────────────────────────────
# 데이터 수명주기 — 보관 일수가 지난 '달 전체'를 압축 파일(var/archive)로 보관·검증한 뒤 DB 에서 정리(매월 2일). 0 = 정리 안 함
# NEWS_RETENTION_DAYS=400          # 뉴스·종목 태깅·감성(약 13개월)
# SEARCH_LOG_RETENTION_DAYS=400    # 검색 기록(키워드·고른 종목 — 개인정보 없음)
# ILM_ARCHIVE_DIR=var/archive      # 위 BACKUP_OFFSITE_CMD 가 있으면 보관 파일도 같은 명령으로 외부에 — 복사가 성공한 달만 DB 에서 지운다
# ILM_ENABLED=1
# DB 진단 — 이 일수 안에 디스크가 찰 추세면 경보(DB 와 같은 서버의 디스크를 본다)
# DB_DISK_ALERT_DAYS=90
# DB_DISK_PATH=/
# 연결 시간대(시간대 없는 시각 = 한국시간) · 백업 압축(auto = pg_dump 16+ 이면 zstd:3)
# DB_TIMEZONE=Asia/Seoul
# BACKUP_COMPRESSION=auto
# vm.sh install·update 가 서버 메모리·CPU 에 맞춰 PostgreSQL 설정을 적용(ALTER SYSTEM) — 끄려면 off
# DB_AUTOTUNE=on
