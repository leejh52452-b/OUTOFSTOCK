# ═══════════════════════════════════════════════════════════════════════════════
# OUTOFSTOCK 운영 환경파일 예시 — install -m 600 env.prod.example .env 후 값 채우기
#   (cp 로 만들면 644 라 같은 서버의 다른 계정이 키를 읽는다 — 반드시 600)
#
# 배치 두 가지
#   VM(systemd)    : bash deploy/vm.sh install — API·스케줄러·실시간·백업이 이 .env 를 읽는다. DATABASE_URL 을 직접 적는다.
#   Docker compose : ./deploy/deploy.sh — 이 .env 는 앱 컨테이너 환경변수 + compose 변수. DB 비밀번호는 .env.db(env.db.example)에만,
#                    DB 접속 문자열은 compose 가 최소 권한 계정(oos_app·oos_ro·oos_backup)으로 만든다(여기 적어도 무시).
# 규칙: 값 뒤에 인라인 주석 금지(systemd·compose 가 값의 일부로 읽는다) · git 에 올리지 말 것 · ★ = 비밀값
# 설정 근거·매핑: docs/security/ (제로트러스트·규정 매핑) · 배포 절차: DEPLOY_UBUNTU.md · 복구: docs/dr/README.md
# ═══════════════════════════════════════════════════════════════════════════════

# ── DB 연결(VM 만) ─────────────────────────────────────────────────────────────
# 처음엔 소유자 계정 하나로 시작해도 된다(vm.sh install 이 계정·DB 를 만든다). 영문·숫자 비밀번호(openssl rand -hex 24).
DATABASE_URL=postgresql+psycopg://oos:CHANGE_ME_hex@localhost:5432/outofstock
# 권한 분리(deploy/sql/roles.sql — docs/security/db_roles.md) 뒤에는:
#   DATABASE_URL=postgresql+psycopg://oos_app:…@localhost:5432/outofstock            서비스(RLS 적용·DDL 없음)
#   ANALYTICS_DATABASE_URL=postgresql+psycopg://oos_ro:…@localhost:5432/outofstock   분석 CLI(run.py analytics-query — 읽기 전용·개인정보 표 없음)
#   BACKUP_DATABASE_URL=postgresql+psycopg://oos_backup:…@localhost:5432/outofstock  백업(읽기 전용 + RLS 우회, 백업 타이머만)
#   마이그레이션 계정은 .env 에 두지 않는다 — 업데이트 때만: MIGRATION_DATABASE_URL=…oos_owner… bash deploy/vm.sh update
# 앱↔DB TLS(DB 가 다른 서버일 때): URL 끝에 ?sslmode=verify-full&sslrootcert=/경로/ca.crt

# ── 경계(공개 범위) ───────────────────────────────────────────────────────────
# API 문서(/docs·/redoc·/openapi.json) — 운영에서는 숨긴다(nginx 도 404)
DOCS_ENABLED=false
# 다른 출처(도메인·포트)의 화면이 API 를 부를 때만 — 쿠키는 보내지 않는다(그 화면은 Bearer 토큰). 같은 서버가 화면을 주면 비워 둔다
CORS_ORIGINS=
# 쿠키 인증 변경 요청의 Origin 허용 목록(쉼표) — 비우면 요청 Host 와 같은 출처만
TRUSTED_ORIGINS=
# 쿠키 Secure·__Host- 접두어 — auto(HTTPS 요청이면 켬) | true(TLS 경계 뒤에서 권장) | false
COOKIE_SECURE=auto
# HTTPS 로 서비스할 때만 true(브라우저가 1년 동안 HTTP 로 오지 않게)
SECURITY_HSTS=false
# Content-Security-Policy — 비우면 기본(엄격: nonce·Trusted Types·인라인 금지), 'off' 면 끔(권장하지 않음)
SECURITY_CSP=
# /admin 동작은 관리 기기 인증서(nginx mTLS)가 있어야 — nginx(deploy/nginx.conf) 뒤에서 앱이 127.0.0.1 일 때만 true
#   (앱이 바깥에 직접 열려 있으면 인증서 확인 헤더를 위조할 수 있다 — vm.sh 가 경고한다)
ADMIN_REQUIRE_CLIENT_CERT=false
# 요청 본문 상한(바이트, 넘으면 413)
MAX_BODY_BYTES=1000000

# ── 세션·인증(기본값이 권장값 — 바꿀 때만 주석 해제) ─────────────────────────────
# ACCESS_TOKEN_TTL_SECONDS=600
# SESSION_IDLE_SECONDS=1800
# SESSION_ABSOLUTE_SECONDS=43200
# STEP_UP_MAX_AGE_SECONDS=300
# MAX_SESSIONS_PER_USER=5
# ACCOUNT_LOCK_THRESHOLD=5
# ACCOUNT_LOCK_SECONDS=900
LOGIN_MAX_FAILS=5
LOGIN_MAX_FAILS_PER_IP=100
LOGIN_WINDOW_SECONDS=600
REGISTER_MAX_PER_IP=20
PRACTICE_RECORD_MAX_PER_HOUR=120
HEAVY_MISS_PER_MIN=12
PASSWORD_HASH_ITERATIONS=600000
# 시도 제한 저장소 — postgres(워커·서버가 여럿이어도 같은 한도) | memory(개발)
RATE_LIMIT_BACKEND=postgres

# ── 키 ★ — 생성: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())" ──────────
# 마스터 키(비밀번호 페퍼·IP 가명화·감사 증인 서명 등 용도별 하위 키를 파생). 바꾸면 예전 키를 _OLD 에(읽기만)
APP_SECRET_KEY=
APP_SECRET_KEYS_OLD=
# 데이터 암호화 키(봉투 암호화 KEK — KIS 토큰·결제 키·개인정보 열). 교체: 새 키를 위에, 예전 키를 _OLD 에 → python run.py crypto-rotate
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEYS_OLD=

# ── 관리 역할 — 상시 권한 없음: 자격만 주고, 쓸 때 TOTP 로 시간 제한 활성(JIT) ─────────
ADMIN_USERS=
# JIT_MAX_MINUTES=30
# ROLE_GRANT_DAYS=90
# ROLE_DORMANT_DAYS=60          # 이 기간 한 번도 켜지 않은 관리 자격은 매일 자동 회수(부트스트랩 제외 — 표시만)

# ── 나가는 연결(egress) — 허용 목록 밖은 차단(app/security/egress.py) ─────────────
# enforce(차단) | monitor(기록만 — 새 원천을 붙일 때 관찰) | off
EGRESS_MODE=enforce
# 추가 허용 호스트(쉼표) — 사내 알림 서버 등. VM 의 egress 프록시(EGRESS_PROXY=1)·compose 프록시 설정에도 함께 들어간다
EGRESS_EXTRA_HOSTS=
# EGRESS_MAX_CONCURRENCY=8

# ── 로그·감사·보관 ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json: 한 줄 JSON(요청 ID 포함) — 로그 수집기·SIEM 연동
LOG_FORMAT=json
# 감사 로그 체인 머리를 매일 DB 밖에 남기는 증인 파일 — VM: 서비스 상태 폴더(샌드박스가 쓰기를 허용) · compose: 자동(/var/lib/oos)
AUDIT_WITNESS_FILE=/var/lib/outofstock/audit-witness.jsonl
# AUDIT_RETENTION_DAYS=1095
# ACCESS_LOG_RETENTION_DAYS=365
# SECURITY_EVENT_RETENTION_DAYS=365
# PII_LOG_RETENTION_DAYS=730

# ── DB 세션 한도(복원력) ────────────────────────────────────────────────────────
# 한 쿼리 시간 제한은 API 에만 건다(배치 적재는 오래 걸릴 수 있다) — vm.sh·compose 가 API 서비스에만 이 값을 넣는다
#   (DB_STATEMENT_TIMEOUT_MS 를 여기 직접 적으면 스케줄러까지 끊기니 적지 말 것)
API_STATEMENT_TIMEOUT_MS=5000
# DB_IDLE_TX_TIMEOUT_MS=60000

# ── 백업·복구(docs/dr/README.md) ─────────────────────────────────────────────
# age 공개키 파일(서버엔 공개키만, 복호화 키는 오프라인) — VM 예: /etc/outofstock/backup.recipients · compose: 자동
BACKUP_AGE_RECIPIENTS=
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_MONTHLY=12
# 원격 사본(선택, 셸 없이 실행) — 예: rclone copy {file} remote:oos-backups/
BACKUP_OFFSITE_CMD=
# BACKUP_MAX_AGE_HOURS=26
# DR_DRILL_MAX_AGE_DAYS=92
# DR_RTO_TARGET_MIN=180       # 복구목표시간(분) — 전자금융감독규정 제23조 3시간. 훈련 실측 RTO 가 넘으면 진단 점검 실패

# ── DB 운영(ADR-0027 — 저장 표준·수명주기·진단·서버 튜닝) ───────────────────────────────
# 데이터 수명주기 — 보관 일수가 지난 '달 전체'를 압축 파일(var/archive)로 보관·검증한 뒤 DB 에서 정리(매월 2일). 0 = 정리 안 함
# NEWS_RETENTION_DAYS=400          # 뉴스·종목 태깅·감성(약 13개월)
# SEARCH_LOG_RETENTION_DAYS=400    # 검색 기록(키워드·고른 종목 — 개인정보 없음)
# ILM_ARCHIVE_DIR=var/archive      # 위 BACKUP_OFFSITE_CMD 가 있으면 보관 파일도 같은 명령으로 외부에 — 복사가 성공한 달만 DB 에서 지운다
# ILM_ENABLED=1
# DB 진단 — 이 일수 안에 디스크가 찰 추세면 경보(DB 와 같은 서버의 디스크를 본다)
# DB_DISK_ALERT_DAYS=90
# DB_DISK_PATH=/
# 연결 시간대(시간대 없는 시각 = 한국시간) · 백업 압축(auto = pg_dump 16+ 이면 zstd:3)
# DB_TIMEZONE=Asia/Seoul
# BACKUP_COMPRESSION=auto
# vm.sh install·update 가 서버 메모리·CPU 에 맞춰 PostgreSQL 설정을 적용(ALTER SYSTEM) — 끄려면 off
# DB_AUTOTUNE=on

# ── IT 내부통제(ADR-0026 — 금감원 IT 내부통제·시행세칙 제7조의4) ────────────────────────────
# 변경관리 — 금융 운영은 enforce(승인된 설치본만·배포 금지 시간 준수). 기본 record 는 막지 않고 '미승인 배포'로 기록만.
#   어느 모드든 배포를 깨뜨리는 자동 점검 실패(구문·적용된 마이그레이션·정책 형식)는 막는다. 긴급: CHANGE_REASON='사유' bash deploy/vm.sh update …
CHANGE_GATE=enforce
# CHANGE_FREEZE=mon-fri 08:30-16:00   # 배포 금지 시간(KST) — 'daily HH:MM-HH:MM' · none
# 가용성 감시(1분 합성 모니터링 → 장애 판정·보고 대상) — VM systemd 는 vm.sh 가 실제 포트로 넣는다. off 면 끔
# UPTIME_URL=auto
# UPTIME_SLOW_MS=3000
# UPTIME_SLO=99.5

# ── compose 전용(변수 치환) — VM 이면 무시된다 ─────────────────────────────────
# 공개 포트(edge nginx 만 연다)
HTTP_PORT=80
HTTPS_PORT=443
# http | tls (tls: deploy/pki/make-pki.sh compose deploy/tls → COOKIE_SECURE=true · SECURITY_HSTS=true 와 함께)
EDGE_MODE=http
WORKERS=2
# APP_VERSION=local
# BACKUP_HOST_DIR=./var/backups
# BACKUP_RECIPIENTS_FILE=./deploy/backup/recipients.txt

# ── 데이터 소스 키 ★ (있으면 실데이터, 없으면 표본) ─────────────────────────────
MARKET_SOURCE=krx
UNIVERSE_TOP_N=150
NEWS_REQUEST_GAP=0.5
NEWS_MAX_FAILS=5
KRX_API_KEY=
DART_API_KEY=
DART_BSNS_YEAR=2025
DART_REPRT_CODE=11011
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER=false
OVERSEAS_SOURCE=auto
FINNHUB_API_KEY=
# SEC EDGAR — 인증키가 아니라 식별용 연락처(본인 이메일)
SEC_USER_AGENT=OUTOFSTOCK-capstone your-email@example.com
EXIM_API_KEY=
ECOS_API_KEY=

# ── 가상머니 지갑·결제 ─────────────────────────────────────────────────────────
WALLET_WELCOME_BONUS=1000000
ATTENDANCE_DAILY_REWARD=1000000
QUIZ_REWARD_PER_CORRECT=100000
TRANSFER_MAX=100000000
IAP_VERIFY_MODE=stub
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MODE=stub

# ── 배치 스케줄(scheduler.py) — 매일 이 시각(한국시간) run.py real ─────────────────
REAL_PIPELINE_TIME=23:00
REAL_PIPELINE_DAYS=mon-sun
REAL_PIPELINE_CATCHUP=true

# ── 장애 알림(선택) — 설정한 채널 모두로. 시험: python run.py alert-test ───────────────
# 웹훅(Slack·Discord·일반 JSON) ★ 주소 자체가 비밀번호
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 메일(STARTTLS) ★ — VM 에서 EGRESS_PROXY=1 이면 메일 서버 주소를 EGRESS_ALLOW_IPS 에(메일은 프록시를 거치지 않는다)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# ALERT_DEDUP_HOURS=6
# ALERT_ACK_MINUTES=15        # 오류 경보를 이 시간 안에 아무도 확인(POST /admin/alerts/{id}/ack)하지 않으면 한 번 상향
# QUALITY_MIN_UNIVERSE_RATIO=0.9
# QUALITY_MIN_HISTORY_BARS=60
# QUALITY_MIN_HISTORY_SHARE=0.9

# ── 분석 계층·추천(선택 — 기본값 있음) ─────────────────────────────────────────
# ANALYTICS_YEARS=10
# ANALYTICS_BACKFILL_BUDGET=1200
# ANALYTICS_QUERY_TIMEOUT_MS=5000
# RECO_MIN_VALUE=500000000
# RECO_COST_BPS=25
# RISK_FREE_RATE=0.03

# ── 용량·성능 관리 · 대량접속제어(ADR-0023 — 금감원 IT 안정성 가이드라인 '성능 관리') ──────────────────
# 임계치 4단계(정상·주의·경계·심각) = 워커별 동시 요청/한도 · DB 연결 사용률(비율) + p95 지연(ms) · 5xx 비율.
# 경계면 공개 시세·뉴스(low), 심각이면 일반 조회(normal)까지 503 — 로그인·송금·결제·관리(critical)는 끝까지 받는다
# CAPACITY_ADMISSION=on
# CAPACITY_MAX_INFLIGHT=40                 # 워커 하나의 스레드풀(40)에 맞춤 — 워커가 여럿이면 서버 한도 = 이 값 × 워커 수
# CAPACITY_RATIOS=0.6,0.8,0.95             # 주의·경계·심각
# CAPACITY_P95_MS=500,1000,3000
# CAPACITY_REPORT_COOLDOWN_S=600           # 같은 단계 성능관리보고서는 10분에 1번
# DB_POOL_TIMEOUT_S=5                      # 연결 풀이 다 찼을 때 기다리는 시간(초) — 넘으면 503(Retry-After)
