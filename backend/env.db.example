# ═══════════════════════════════════════════════════════════════
# OUTOFSTOCK — DB 비밀번호(compose 운영 오버레이 전용).   install -m 600 env.db.example .env.db   후 값 채우기.
# compose 가 '접속 문자열을 만들 때만' 읽는다 — 앱 컨테이너에는 자기 계정(oos_app) 것만 들어간다.
# 값은 영문·숫자만(openssl rand -hex 24) — '@ : / % # ' 가 들어가면 접속 URL 이 깨진다. 절대 git 에 올리지 말 것.
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=oos
POSTGRES_DB=outofstock
# 슈퍼유저 — DB 컨테이너 초기화·역할 설정(deploy.sh)에만. 앱은 이 계정을 쓰지 않는다(쓰면 RLS 가 우회된다)
POSTGRES_PASSWORD=CHANGE_ME
# 최소 권한 계정(deploy/sql/roles.sql 이 만든다)
OOS_OWNER_PASSWORD=CHANGE_ME
OOS_APP_PASSWORD=CHANGE_ME
OOS_RO_PASSWORD=CHANGE_ME
OOS_BACKUP_PASSWORD=CHANGE_ME

# ── 앱↔DB TLS(선택) — deploy/pki/make-pki.sh compose 로 인증서를 만든 뒤 세 줄을 켠다 ──
# DB_TLS=on
# DB_HBA_FILE=/etc/oos/pg_hba_tls.conf
# DB_SSL_QUERY=?sslmode=verify-full&sslrootcert=/tls/ca.crt

# ── DB 메모리(선택, ADR-0027) — 기본값은 DB 컨테이너 메모리 한도 2GB 기준(한도를 올리면 함께). 권장값 계산: python run.py db-tune-plan --ram-mb <MB> --cpus <N> --pg 16 ──
# DB_SHARED_BUFFERS=512MB
# DB_EFFECTIVE_CACHE_SIZE=1GB
# DB_WORK_MEM=8MB
# DB_MAINTENANCE_WORK_MEM=128MB
